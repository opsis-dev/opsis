material {
    name : tint,
    shadingModel : unlit,
    parameters : [
        { type : sampler2d, name : input0 },
        { type : float, name : amount }
    ],
    requires : [ uv0 ],
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 color = texture(materialParams_input0, getUV0());
        material.baseColor = vec4(color.rgb * materialParams.amount, color.a);
    }
}
