unsetopt PROMPT_SP
unset HISTFILE
SAVEHIST=0
__opsis_precmd() {
  local code=$?
  if [[ -n $__opsis_started ]]; then
    print -n "\e]133;D;$code\a"
  fi
  __opsis_started=1
  print -n "\e]133;A\a"
}
__opsis_preexec() {
  print -n "\e]133;C\a"
}
precmd_functions+=(__opsis_precmd)
preexec_functions+=(__opsis_preexec)
PROMPT=$'%{\e[1;32m%}opsis%{\e[0m%}:%{\e[1;34m%}%~%{\e[0m%}$ %{\e]133;B\a%}'
