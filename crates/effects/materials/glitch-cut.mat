material {
    name : glitchCut,
    shadingModel : unlit,
    blending : transparent,
    parameters : [
        { type : sampler2d, name : input0 },
        { type : sampler2d, name : input1 },
        { type : float, name : aspect },
        { type : float2, name : size },
        { type : float, name : scale },
        { type : float, name : progress },
        { type : float, name : intensity },
        { type : float, name : slices },
        { type : float, name : rgbSplit },
        { type : float, name : blockNoise },
        { type : float, name : steps },
        { type : float, name : blockColumns },
        { type : float3, name : tint }
    ],
    requires : [ uv0 ],
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none
}

fragment {
    #include "pcg-hash.glsl"


    vec4 sampleSplit(bool from, vec2 uv, float split) {
        vec4 center = from ? texture(materialParams_input0, uv) : texture(materialParams_input1, uv);
        float r = from ? texture(materialParams_input0, vec2(uv.x + split, uv.y)).r : texture(materialParams_input1, vec2(uv.x + split, uv.y)).r;
        float b = from ? texture(materialParams_input0, vec2(uv.x - split, uv.y)).b : texture(materialParams_input1, vec2(uv.x - split, uv.y)).b;
        return vec4(r, center.g, b, center.a);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 vuv = getUV0();
        float progress = materialParams.progress;
        float intensity = materialParams.intensity;
        float energy = pow(max(sin(progress * 3.141592653589793), 0.0), 0.7);
        float clock = floor(progress * materialParams.steps);
        float row = floor(vuv.y * materialParams.slices);
        float torn = step(0.45, hash(vec2(row, clock)));
        float amount = hash(vec2(row + 17.0, clock * 1.7 + 3.0)) - 0.5;
        float sliceShift = amount * 0.3 * intensity * energy * torn;
        vec2 block = vec2(floor(vuv.x * materialParams.blockColumns), row);
        float corrupt = step(1.0 - materialParams.blockNoise * 0.5 * energy, hash(block + clock * 7.3));
        float blockShift = (hash(block + clock * 3.1 + 5.0) - 0.5) * 0.2 * intensity * corrupt;
        vec2 uv = vec2(fract(vuv.x + sliceShift + blockShift), vuv.y);
        float split = materialParams.rgbSplit * 0.018 * energy * (0.35 + abs(amount));
        float cut = 0.5 + (hash(vec2(row, 91.0)) - 0.5) * 0.32;
        float handed = step(cut, progress);
        vec4 from = sampleSplit(true, uv, split);
        vec4 to = sampleSplit(false, uv, split);
        vec4 color = mix(from, to, handed);
        vec4 leaked = mix(to, from, handed);
        float leak = corrupt * step(0.55, hash(block + clock * 11.0 + 13.0));
        color = mix(color, leaked, leak * 0.8);
        color.rgb += materialParams.tint * energy * torn * hash(vec2(row, clock + 41.0)) * color.a;
        material.baseColor = vec4(color.rgb * color.a, color.a);
    }
}
