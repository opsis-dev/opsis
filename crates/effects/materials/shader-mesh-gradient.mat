material {
    name : shaderMeshGradient,
    shadingModel : unlit,
    blending : transparent,
    parameters : [
        #include "paper-parameters.mat"
        { type : float4[10], name : colors },
        { type : float, name : colorsCount },
        { type : float, name : distortion },
        { type : float, name : swirl },
        { type : float, name : grainMixer },
        { type : float, name : grainOverlay }
    ],
    requires : [ uv0 ],
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none
}

fragment {
    #include "paper-sizing.glsl"
    #include "paper-colors.glsl"

    vec2 rotate(vec2 uv, float th) {
        return mat2(cos(th), sin(th), -sin(th), cos(th)) * uv;
    }

    float hash21(vec2 p) {
        p = fract(p * vec2(0.3183099, 0.3678794)) + 0.1;
        p += dot(p, p + 19.19);
        return fract(p.x * p.y);
    }

    float valueNoise(vec2 st) {
        vec2 i = floor(st);
        vec2 f = fract(st);
        float a = hash21(i);
        float b = hash21(i + vec2(1.0, 0.0));
        float c = hash21(i + vec2(0.0, 1.0));
        float d = hash21(i + vec2(1.0, 1.0));
        vec2 u = f * f * (3.0 - 2.0 * f);
        float x1 = mix(a, b, u.x);
        float x2 = mix(c, d, u.x);
        return mix(x1, x2, u.y);
    }

    vec2 getPosition(int i, float t) {
        float a = float(i) * 0.37;
        float b = 0.6 + fract(float(i) / 3.0) * 0.9;
        float c = 0.8 + fract(float(i + 1) / 4.0);
        float x = sin(t * b + a);
        float y = cos(t * c + a * 1.5);
        return 0.5 + 0.5 * vec2(x, y);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = paperObjectUV();
        uv += 0.5;
        vec2 grainUV = uv * 1000.0;
        float mixerGrain = 0.0;
        if (materialParams.grainMixer > 0.0) {
            mixerGrain = 0.4 * materialParams.grainMixer * (valueNoise(grainUV) - 0.5);
        }
        float t = 0.5 * (materialParams.time + 41.5);
        float radius = smoothstep(0.0, 1.0, length(uv - 0.5));
        float center = 1.0 - radius;
        float distortion = materialParams.distortion;
        for (float i = 1.0; i <= 2.0; i++) {
            uv.x += distortion * center / i * sin(t + i * 0.4 * smoothstep(0.0, 1.0, uv.y)) * cos(0.2 * t + i * 2.4 * smoothstep(0.0, 1.0, uv.y));
            uv.y += distortion * center / i * cos(t + i * 2.0 * smoothstep(0.0, 1.0, uv.x));
        }
        vec2 uvRotated = uv - vec2(0.5);
        float angle = 3.0 * materialParams.swirl * radius;
        uvRotated = rotate(uvRotated, -angle);
        uvRotated += vec2(0.5);
        vec3 color = vec3(0.0);
        float opacity = 0.0;
        float totalWeight = 0.0;
        for (int i = 0; i < 10; i++) {
            if (i >= int(materialParams.colorsCount)) break;
            vec2 pos = getPosition(i, t) + mixerGrain;
            vec4 shade = paperColor(i);
            float dist = pow(length(uvRotated - pos), 3.5);
            float weight = 1.0 / (dist + 1e-3);
            color += shade.rgb * shade.a * weight;
            opacity += shade.a * weight;
            totalWeight += weight;
        }
        color /= max(1e-4, totalWeight);
        opacity /= max(1e-4, totalWeight);
        if (materialParams.grainOverlay > 0.0) {
            float grainOverlay = valueNoise(rotate(grainUV, 1.0) + vec2(3.0));
            grainOverlay = mix(grainOverlay, valueNoise(rotate(grainUV, 2.0) + vec2(-1.0)), 0.5);
            grainOverlay = pow(grainOverlay, 1.3);
            float grainOverlayV = grainOverlay * 2.0 - 1.0;
            vec3 grainOverlayColor = vec3(step(0.0, grainOverlayV));
            float grainOverlayStrength = pow(materialParams.grainOverlay * abs(grainOverlayV), 0.8);
            color = mix(color, grainOverlayColor, 0.35 * grainOverlayStrength);
            opacity += 0.5 * grainOverlayStrength;
        }
        opacity = clamp(opacity, 0.0, 1.0);
        material.baseColor = vec4(color, opacity);
    }
}
