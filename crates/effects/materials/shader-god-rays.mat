material {
    name : shaderGodRays,
    shadingModel : unlit,
    blending : transparent,
    parameters : [
        { type : sampler2d, name : input0 },
        #include "paper-parameters.mat"
        { type : float4, name : colorBack },
        { type : float4, name : colorBloom },
        { type : float4[10], name : colors },
        { type : float, name : colorsCount },
        { type : float, name : density },
        { type : float, name : spotty },
        { type : float, name : midSize },
        { type : float, name : midIntensity },
        { type : float, name : intensity },
        { type : float, name : bloom }
    ],
    requires : [ uv0 ],
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none
}

fragment {
    #include "paper-sizing.glsl"
    #include "paper-colors.glsl"

    vec2 rotate(vec2 uv, float th) {
        return mat2(cos(th), sin(th), -sin(th), cos(th)) * uv;
    }

    float randomR(vec2 p) {
        vec2 uv = floor(p) / 100.0 + 0.5;
        return texture(materialParams_input0, fract(uv)).r;
    }

    float valueNoise(vec2 st) {
        vec2 i = floor(st);
        vec2 f = fract(st);
        float a = randomR(i);
        float b = randomR(i + vec2(1.0, 0.0));
        float c = randomR(i + vec2(0.0, 1.0));
        float d = randomR(i + vec2(1.0, 1.0));
        vec2 u = f * f * (3.0 - 2.0 * f);
        float x1 = mix(a, b, u.x);
        float x2 = mix(c, d, u.x);
        return mix(x1, x2, u.y);
    }

    float hash11(float p) {
        p = fract(p * 0.3183099) + 0.1;
        p *= p + 19.19;
        return fract(p * p);
    }

    float raysShape(vec2 uv, float r, float freq, float intensity) {
        float twoPi = 6.28318530718;
        float a = atan(uv.y, uv.x);
        vec2 left = vec2(a * freq, r);
        vec2 right = vec2(fract(a / twoPi) * twoPi * freq, r);
        float nLeft = pow(valueNoise(left), intensity);
        float nRight = pow(valueNoise(right), intensity);
        return mix(nRight, nLeft, smoothstep(-0.15, 0.15, uv.x));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 shapeUv = paperObjectUV();
        float t = 0.2 * materialParams.time;
        float radius = length(shapeUv);
        float spots = 6.5 * abs(materialParams.spotty);
        float intensity = 4.0 - 3.0 * clamp(materialParams.intensity, 0.0, 1.0);
        float midSize = 10.0 * abs(materialParams.midSize);
        float msLo = 0.02 * midSize;
        float msHi = max(midSize, 1e-6);
        float middleShape = pow(materialParams.midIntensity, 0.3) * (1.0 - smoothstep(msLo, msHi, 3.0 * radius));
        middleShape = pow(middleShape, 5.0);
        vec3 accumColor = vec3(0.0);
        float accumAlpha = 0.0;
        float bloom = materialParams.bloom;
        float densitySetting = materialParams.density;
        for (int i = 0; i < 10; i++) {
            if (i >= int(materialParams.colorsCount)) break;
            vec2 rotatedUV = rotate(shapeUv, float(i) + 1.0);
            float r1 = radius * (1.0 + 0.4 * float(i)) - 3.0 * t;
            float r2 = 0.5 * radius * (1.0 + spots) - 2.0 * t;
            float density = 6.0 * densitySetting + step(0.5, densitySetting) * pow(4.5 * (densitySetting - 0.5), 4.0);
            float f = mix(1.0, 3.0 + 0.5 * float(i), hash11(float(i) * 15.0)) * density;
            float ray = raysShape(rotatedUV, r1, 5.0 * f, intensity);
            ray *= raysShape(rotatedUV, r2, 4.0 * f, intensity);
            ray += (1.0 + 4.0 * ray) * middleShape;
            ray = clamp(ray, 0.0, 1.0);
            vec4 shade = paperColor(i);
            float srcAlpha = shade.a * ray;
            vec3 srcColor = shade.rgb * srcAlpha;
            vec3 alphaBlendColor = accumColor + (1.0 - accumAlpha) * srcColor;
            float alphaBlendAlpha = accumAlpha + (1.0 - accumAlpha) * srcAlpha;
            vec3 addBlendColor = accumColor + srcColor;
            float addBlendAlpha = accumAlpha + srcAlpha;
            accumColor = mix(alphaBlendColor, addBlendColor, bloom);
            accumAlpha = mix(alphaBlendAlpha, addBlendAlpha, bloom);
        }
        vec4 bloomColor = materialParams.colorBloom;
        vec3 overlayColor = bloomColor.rgb * bloomColor.a;
        vec3 colorWithOverlay = accumColor + accumAlpha * overlayColor;
        accumColor = mix(accumColor, colorWithOverlay, bloom);
        vec4 back = materialParams.colorBack;
        vec3 color = accumColor + (1.0 - accumAlpha) * back.rgb * back.a;
        float opacity = accumAlpha + (1.0 - accumAlpha) * back.a;
        color = clamp(color, 0.0, 1.0);
        opacity = clamp(opacity, 0.0, 1.0);
        material.baseColor = vec4(paperBandingFix(color), opacity);
    }
}
