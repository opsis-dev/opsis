material {
    name : halftonePrint,
    shadingModel : unlit,
    blending : transparent,
    parameters : [
        { type : sampler2d, name : input0 },
        { type : float, name : aspect },
        { type : float, name : cell },
        { type : float, name : angle },
        { type : float, name : shift },
        { type : float3, name : paper },
        { type : float3, name : cyanAbsorb },
        { type : float3, name : magentaAbsorb },
        { type : float3, name : yellowAbsorb }
    ],
    requires : [ uv0 ],
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none
}

fragment {
    vec2 toSquare(vec2 uv) {
        return vec2(uv.x * materialParams.aspect, uv.y);
    }

    vec2 fromSquare(vec2 p) {
        return vec2(p.x / materialParams.aspect, p.y);
    }

    float screenInk(vec2 uv, float angle, vec2 drift, vec3 pick) {
        float cell = materialParams.cell;
        vec2 p = toSquare(uv);
        float s = sin(angle);
        float c = cos(angle);
        vec2 r = vec2(p.x * c - p.y * s, p.x * s + p.y * c);
        vec2 center = (floor(r / cell) + 0.5) * cell;
        vec2 unrotated = vec2(center.x * c + center.y * s, -center.x * s + center.y * c);
        vec4 texel = texture(materialParams_input0, fromSquare(unrotated + drift));
        vec3 straight = texel.rgb / max(texel.a, 0.004);
        float ink = clamp(1.0 - dot(straight, pick), 0.0, 1.0) * texel.a;
        float radius = sqrt(ink) * cell * 0.72;
        float aa = cell * 0.045;
        float coverage = 1.0 - smoothstep(radius - aa, radius + aa, length(r - center));
        return coverage * step(0.002, ink);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        vec4 source = texture(materialParams_input0, uv);
        float shift = materialParams.shift;
        float angle = materialParams.angle;
        float cyan = screenInk(uv, angle + 0.2618, shift * vec2(1.0, 0.0), vec3(1.0, 0.0, 0.0));
        float magenta = screenInk(uv, angle + 1.3090, shift * vec2(-0.5, 0.866), vec3(0.0, 1.0, 0.0));
        float yellow = screenInk(uv, angle, shift * vec2(-0.5, -0.866), vec3(0.0, 0.0, 1.0));
        vec3 color = materialParams.paper;
        color *= 1.0 - cyan * materialParams.cyanAbsorb;
        color *= 1.0 - magenta * materialParams.magentaAbsorb;
        color *= 1.0 - yellow * materialParams.yellowAbsorb;
        material.baseColor = vec4(color * source.a, source.a);
    }
}
