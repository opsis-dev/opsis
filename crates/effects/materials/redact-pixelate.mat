material {
    name : redactPixelate,
    shadingModel : unlit,
    blending : transparent,
    parameters : [
        { type : sampler2d, name : input0 },
        { type : float, name : aspect },
        { type : float2, name : size },
        { type : float, name : scale },
        { type : float4[8], name : regions },
        { type : float, name : regionCount },
        { type : float2, name : cell }
    ],
    requires : [ uv0 ],
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none
}

fragment {
    vec4 cellAverage(vec2 center, vec2 cell) {
        vec4 sum = vec4(0.0);
        for (int y = 0; y < 3; y++) {
            for (int x = 0; x < 3; x++) {
                vec2 offset = (vec2(float(x), float(y)) + 0.5) / 3.0 - 0.5;
                sum += texture(materialParams_input0, center + offset * cell);
            }
        }
        return sum / 9.0;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 vuv = getUV0();
        vec4 result = texture(materialParams_input0, vuv);
        vec2 cell = max(materialParams.cell, vec2(0.0005));
        for (int i = 0; i < 8; i++) {
            if (i >= int(materialParams.regionCount)) {
                continue;
            }
            vec4 region = materialParams.regions[i];
            vec2 lo = region.xy;
            vec2 hi = region.xy + region.zw;
            vec2 hit = step(lo, vuv) * step(vuv, hi);
            if (hit.x * hit.y < 0.5) {
                continue;
            }
            vec2 center = lo + (floor((vuv - lo) / cell) + 0.5) * cell;
            result = vec4(cellAverage(center, cell).rgb, 1.0);
        }
        material.baseColor = vec4(result.rgb * result.a, result.a);
    }
}
