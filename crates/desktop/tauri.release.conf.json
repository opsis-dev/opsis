{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi", "app", "dmg"],
    "publisher": "Bismit Panda",
    "copyright": "Copyright 2026 Bismit Panda",
    "category": "Video",
    "shortDescription": "Record a real website and turn it into a polished product demo.",
    "longDescription": "Opsis records a real website, then turns the take into a product demo with camera moves, captions, sound and graphics, and exports it as a video.",
    "homepage": "https://github.com/bismitpanda/opsis",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../film-bundle/": "film-bundle/",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../resources/engine-licences/": "engine-licences/",
      "../../LICENSE": "LICENSE"
    },
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-libav"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    }
  }
}
