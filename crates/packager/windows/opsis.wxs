<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.PRODUCT)" Manufacturer="$(var.PUBLISHER)" Version="$(var.VERSION)" UpgradeCode="98166C63-D1F3-45A4-8BB8-3EC7ECC9C66D" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.PRODUCT) is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="opsis.ico" SourceFile="$(var.STAGE)\$(var.ICON)" />
    <Property Id="ARPPRODUCTICON" Value="opsis.ico" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.HOMEPAGE)" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.PRODUCT)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuShortcut" Name="$(var.PRODUCT)" Target="[INSTALLFOLDER]$(var.PROGRAM)" WorkingDirectory="INSTALLFOLDER" Icon="opsis.ico" />
        <RegistryValue Root="HKMU" Key="Software\$(var.PRODUCT)" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="$(var.STAGE)\**" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
