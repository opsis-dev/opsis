{
  "name": "@opsis/e2e",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "e2e": "env -u WAYLAND_DISPLAY GDK_BACKEND=x11 xvfb-run -a -s \"-screen 0 1600x1000x24\" sh -c \"wdio run wdio.conf.ts && bun src/close-check.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "format": "oxfmt -c oxfmt.config.ts --check",
    "format:fix": "oxfmt -c oxfmt.config.ts --write"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.5.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "webdriverio": "^9.31.9"
  }
}
