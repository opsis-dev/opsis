{
  "version": 1,
  "id": "example_feature_launch",
  "name": "Feature launch",
  "settings": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "theme": "dark",
    "fonts": {
      "main": "Inter",
      "heading": "",
      "code": "JetBrains Mono",
      "families": []
    }
  },
  "variables": {
    "Site address": "https://example.com",
    "Product name": "Acme"
  },
  "nodes": [
    {
      "id": "session",
      "type": "browser.open",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "params": {
        "viewportWidth": 1920,
        "viewportHeight": 1080,
        "dpr": 2,
        "mobile": false,
        "userAgent": "",
        "locale": "en-US",
        "timezone": "",
        "colorScheme": "light",
        "captureScale": 1
      }
    },
    {
      "id": "open",
      "type": "browser.navigate",
      "position": {
        "x": 300.0,
        "y": 0.0
      },
      "params": {
        "url": "{{Site address}}",
        "waitUntil": "load",
        "after": 700
      }
    },
    {
      "id": "start",
      "type": "browser.startRecording",
      "position": {
        "x": 600.0,
        "y": 0.0
      },
      "params": {}
    },
    {
      "id": "cta",
      "type": "browser.click",
      "position": {
        "x": 900.0,
        "y": 0.0
      },
      "params": {
        "after": 1500,
        "cluster": "",
        "zoom": true,
        "frame": "",
        "zoomScale": 0,
        "travelMs": 0,
        "hoverMs": 220,
        "target": "Get started"
      },
      "label": "Get started"
    },
    {
      "id": "record",
      "type": "capture.record",
      "position": {
        "x": 1200.0,
        "y": 0.0
      },
      "params": {
        "fps": 30,
        "quality": 90,
        "establishMs": 700,
        "endTailMs": 2500,
        "cursor": "synthetic",
        "showActions": false,
        "mutates": ""
      }
    },
    {
      "id": "camera",
      "type": "camera.take",
      "position": {
        "x": 1200.0,
        "y": 200.0
      },
      "params": {}
    },
    {
      "id": "spotlight",
      "type": "cursor.spotlight",
      "position": {
        "x": 900.0,
        "y": 200.0
      },
      "params": {
        "match": "Get started",
        "color": "rgba(0,0,0,0.55)",
        "padding": 10,
        "leadMs": 250,
        "holdMs": 1400
      }
    },
    {
      "id": "headline",
      "type": "fx.animated-text",
      "position": {
        "x": 300.0,
        "y": 340.0
      },
      "params": {
        "kind": "headline",
        "headline": {
          "text": "Introducing *{{Product name}}*",
          "color": "#fafafa",
          "emphasisColor": "#facc15",
          "background": "#09090b",
          "fontSize": 104,
          "wordStagger": 4,
          "fontFamily": ""
        },
        "clipDuration": 90,
        "envelope": {}
      }
    },
    {
      "id": "outro",
      "type": "fx.title",
      "position": {
        "x": 600.0,
        "y": 510.0
      },
      "params": {
        "eyebrow": "",
        "title": "Try {{Product name}} today",
        "subtitle": "{{Site address}}",
        "align": "center",
        "entrance": "rise",
        "color": "#fafafa",
        "accent": "#a78bfa",
        "background": "transparent",
        "fontSize": 112,
        "fontWeight": 760,
        "fontFamily": "",
        "clipDuration": 75,
        "envelope": {}
      }
    },
    {
      "id": "sequence",
      "type": "timeline.sequence",
      "position": {
        "x": 1200.0,
        "y": 422.0
      },
      "params": {}
    },
    {
      "id": "render",
      "type": "output.render",
      "position": {
        "x": 1500.0,
        "y": 340.0
      },
      "params": {
        "fileName": "{{Project name}}",
        "codec": "h264",
        "crf": 18,
        "variants": [
          "16:9"
        ],
        "reframe": "follow",
        "scale": 1,
        "chapters": true,
        "chapterList": false,
        "gl": "angle"
      }
    },
    {
      "id": "sequence-transition",
      "type": "timeline.transition",
      "position": {
        "x": 900.0,
        "y": 262.0
      },
      "params": {
        "kind": "zoom-blur",
        "durationInFrames": 15
      }
    }
  ],
  "edges": [
    {
      "id": "session.session->open.session",
      "source": "session",
      "sourceHandle": "session",
      "target": "open",
      "targetHandle": "session"
    },
    {
      "id": "open.session->start.session",
      "source": "open",
      "sourceHandle": "session",
      "target": "start",
      "targetHandle": "session"
    },
    {
      "id": "start.session->cta.session",
      "source": "start",
      "sourceHandle": "session",
      "target": "cta",
      "targetHandle": "session"
    },
    {
      "id": "cta.session->record.session",
      "source": "cta",
      "sourceHandle": "session",
      "target": "record",
      "targetHandle": "session"
    },
    {
      "id": "record.recording->camera.recording",
      "source": "record",
      "sourceHandle": "recording",
      "target": "camera",
      "targetHandle": "recording"
    },
    {
      "id": "spotlight.style->camera.style",
      "source": "spotlight",
      "sourceHandle": "style",
      "target": "camera",
      "targetHandle": "style"
    },
    {
      "id": "headline.clip->sequence.in1",
      "source": "headline",
      "sourceHandle": "clip",
      "target": "sequence",
      "targetHandle": "in1"
    },
    {
      "id": "camera.clip->sequence.in2",
      "source": "camera",
      "sourceHandle": "clip",
      "target": "sequence",
      "targetHandle": "in2"
    },
    {
      "id": "outro.clip->sequence.in3",
      "source": "outro",
      "sourceHandle": "clip",
      "target": "sequence",
      "targetHandle": "in3"
    },
    {
      "id": "sequence.clip->render.clip",
      "source": "sequence",
      "sourceHandle": "clip",
      "target": "render",
      "targetHandle": "clip"
    },
    {
      "id": "sequence-transition.transition->sequence.transition",
      "source": "sequence-transition",
      "sourceHandle": "transition",
      "target": "sequence",
      "targetHandle": "transition"
    }
  ],
  "markers": []
}
