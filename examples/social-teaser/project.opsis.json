{
  "version": 1,
  "id": "example_social_teaser",
  "name": "Social teaser (9:16)",
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "theme": "dark",
    "fonts": {
      "main": "Inter",
      "heading": "",
      "code": "JetBrains Mono",
      "families": []
    }
  },
  "variables": {
    "Site address": "https://demo.playwright.dev/todomvc"
  },
  "nodes": [
    {
      "id": "session",
      "type": "browser.open",
      "position": {
        "x": 0.0,
        "y": 0.0
      },
      "params": {
        "viewportWidth": 1440,
        "viewportHeight": 900,
        "dpr": 2,
        "mobile": false,
        "userAgent": "",
        "locale": "en-US",
        "timezone": "",
        "colorScheme": "light",
        "captureScale": 1
      }
    },
    {
      "id": "open",
      "type": "browser.navigate",
      "position": {
        "x": 300.0,
        "y": 0.0
      },
      "params": {
        "url": "{{Site address}}",
        "waitUntil": "load",
        "after": 700
      }
    },
    {
      "id": "start",
      "type": "browser.startRecording",
      "position": {
        "x": 600.0,
        "y": 0.0
      },
      "params": {}
    },
    {
      "id": "type",
      "type": "browser.type",
      "position": {
        "x": 900.0,
        "y": 0.0
      },
      "params": {
        "text": "Ship the teaser",
        "chunkPauseMs": 0,
        "pressEnter": true,
        "after": 1500,
        "cluster": "",
        "zoom": true,
        "frame": "",
        "target": "What needs to be done?"
      }
    },
    {
      "id": "record",
      "type": "capture.record",
      "position": {
        "x": 1200.0,
        "y": 0.0
      },
      "params": {
        "fps": 30,
        "quality": 90,
        "establishMs": 700,
        "endTailMs": 2500,
        "cursor": "synthetic",
        "showActions": false,
        "mutates": ""
      }
    },
    {
      "id": "camera",
      "type": "camera.take",
      "position": {
        "x": 1200.0,
        "y": 200.0
      },
      "params": {}
    },
    {
      "id": "hook",
      "type": "fx.animated-text",
      "position": {
        "x": 300.0,
        "y": 340.0
      },
      "params": {
        "kind": "word-push",
        "word-push": {
          "text": "Words push left.",
          "fontSize": 72,
          "color": "#171717",
          "fontWeight": "600",
          "background": "white",
          "fontFamily": "",
          "speed": 1
        },
        "clipDuration": 60,
        "envelope": {}
      }
    },
    {
      "id": "sequence",
      "type": "timeline.sequence",
      "position": {
        "x": 1200.0,
        "y": 422.0
      },
      "params": {}
    },
    {
      "id": "music",
      "type": "audio.music",
      "position": {
        "x": 1200.0,
        "y": 732.0
      },
      "params": {
        "src": "",
        "volume": 0.4,
        "loop": true,
        "startMs": 0,
        "trimMs": 0,
        "lengthMs": 0,
        "fadeInMs": 800,
        "fadeOutMs": 1500,
        "envelope": {}
      }
    },
    {
      "id": "mix",
      "type": "audio.mix",
      "position": {
        "x": 1500.0,
        "y": 340.0
      },
      "params": {}
    },
    {
      "id": "render",
      "type": "output.render",
      "position": {
        "x": 1800.0,
        "y": 340.0
      },
      "params": {
        "fileName": "{{Project name}}",
        "codec": "h264",
        "crf": 18,
        "variants": [
          "9:16"
        ],
        "reframe": "follow",
        "scale": 1,
        "chapters": true,
        "chapterList": false,
        "gl": "angle"
      }
    },
    {
      "id": "camera-speed",
      "type": "timeline.speed",
      "position": {
        "x": 1200.0,
        "y": 340.0
      },
      "params": {
        "rate": 1.2
      }
    },
    {
      "id": "sequence-transition",
      "type": "timeline.transition",
      "position": {
        "x": 900.0,
        "y": 262.0
      },
      "params": {
        "kind": "push-through",
        "durationInFrames": 16
      }
    }
  ],
  "edges": [
    {
      "id": "session.session->open.session",
      "source": "session",
      "sourceHandle": "session",
      "target": "open",
      "targetHandle": "session"
    },
    {
      "id": "open.session->start.session",
      "source": "open",
      "sourceHandle": "session",
      "target": "start",
      "targetHandle": "session"
    },
    {
      "id": "start.session->type.session",
      "source": "start",
      "sourceHandle": "session",
      "target": "type",
      "targetHandle": "session"
    },
    {
      "id": "type.session->record.session",
      "source": "type",
      "sourceHandle": "session",
      "target": "record",
      "targetHandle": "session"
    },
    {
      "id": "record.recording->camera.recording",
      "source": "record",
      "sourceHandle": "recording",
      "target": "camera",
      "targetHandle": "recording"
    },
    {
      "id": "hook.clip->sequence.in1",
      "source": "hook",
      "sourceHandle": "clip",
      "target": "sequence",
      "targetHandle": "in1"
    },
    {
      "id": "camera-speed.clip->sequence.in2",
      "source": "camera-speed",
      "sourceHandle": "clip",
      "target": "sequence",
      "targetHandle": "in2"
    },
    {
      "id": "sequence.clip->mix.clip",
      "source": "sequence",
      "sourceHandle": "clip",
      "target": "mix",
      "targetHandle": "clip"
    },
    {
      "id": "music.audio->mix.sounds",
      "source": "music",
      "sourceHandle": "audio",
      "target": "mix",
      "targetHandle": "sounds"
    },
    {
      "id": "mix.clip->render.clip",
      "source": "mix",
      "sourceHandle": "clip",
      "target": "render",
      "targetHandle": "clip"
    },
    {
      "id": "camera.clip->camera-speed.clip",
      "source": "camera",
      "sourceHandle": "clip",
      "target": "camera-speed",
      "targetHandle": "clip"
    },
    {
      "id": "sequence-transition.transition->sequence.transition",
      "source": "sequence-transition",
      "sourceHandle": "transition",
      "target": "sequence",
      "targetHandle": "transition"
    }
  ],
  "markers": []
}
