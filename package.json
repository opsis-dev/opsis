{
  "name": "opsis",
  "productName": "Opsis",
  "version": "0.1.0",
  "private": true,
  "description": "Record a real website and turn it into a polished product demo.",
  "keywords": [],
  "license": "Apache-2.0",
  "homepage": "https://github.com/bismitpanda/opsis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bismitpanda/opsis.git"
  },
  "bugs": {
    "url": "https://github.com/bismitpanda/opsis/issues"
  },
  "author": {
    "name": "Bismit Panda",
    "email": "adnaptimsib333@gmail.com"
  },
  "type": "module",
  "main": ".vite/build/main.cjs",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "tsx scripts/start.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "turbo run typecheck typecheck:app",
    "typecheck:app": "tsc --noEmit",
    "lint": "turbo run lint lint:app",
    "lint:app": "oxlint -c oxlint.config.ts",
    "lint:fix": "turbo run lint:fix lint:fix:app",
    "lint:fix:app": "oxlint -c oxlint.config.ts --fix",
    "format": "oxfmt -c oxfmt.config.ts --check",
    "format:fix": "oxfmt -c oxfmt.config.ts --write",
    "test": "turbo run test test:app",
    "test:app": "vitest run",
    "test:watch": "turbo watch test test:app",
    "routes": "bun run --cwd apps/ui routes",
    "studio": "remotion studio packages/video/src/index.ts",
    "registry:ingest": "tsx scripts/registry-ingest.ts",
    "fonts:bundle": "tsx scripts/fonts-bundle.ts",
    "brand:icons": "tsx scripts/brand-icons.ts",
    "engine:licences": "tsx scripts/engine-licences.ts",
    "examples": "tsx scripts/write-examples.ts",
    "elements:render": "tsx scripts/render-elements.ts",
    "glyphs:bundle": "tsx scripts/node-glyphs.ts",
    "three:decoders": "tsx scripts/three-decoders.ts",
    "db:schema": "drizzle-kit export --config drizzle.config.ts > src/main/db/schema.generated.sql"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@opsis/core": "workspace:*",
    "@opsis/sidecar": "workspace:*",
    "@opsis/ui": "workspace:*",
    "@opsis/video": "workspace:*",
    "@remotion/renderer": "4.0.537",
    "culori": "^4.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "electron-squirrel-startup": "^1.0.1",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "p-limit": "^7.3.3",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@remotion/compositor-darwin-arm64": "4.0.537",
    "@remotion/compositor-darwin-x64": "4.0.537",
    "@remotion/compositor-linux-arm64-gnu": "4.0.537",
    "@remotion/compositor-linux-arm64-musl": "4.0.537",
    "@remotion/compositor-linux-x64-gnu": "4.0.537",
    "@remotion/compositor-linux-x64-musl": "4.0.537",
    "@remotion/compositor-win32-x64-msvc": "4.0.537"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@oxlint/plugins": "^1.89.0",
    "@reforged/maker-appimage": "^6.0.0",
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/tailwind-v4": "4.0.537",
    "@tabler/icons": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.44",
    "@tanstack/router-plugin": "^1.168.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "diff": "^9.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "^45.0.0",
    "happy-dom": "^21.0.4",
    "lucide": "^1.61.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  }
}
