{
  "name": "opsis",
  "productName": "Opsis",
  "version": "0.1.0",
  "private": true,
  "description": "Record a real website and turn it into a polished product demo.",
  "keywords": [],
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/opsis-dev/opsis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsis-dev/opsis.git"
  },
  "bugs": {
    "url": "https://github.com/opsis-dev/opsis/issues"
  },
  "author": {
    "name": "Bismit Panda",
    "email": "adnaptimsib333@gmail.com"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "start": "bun scripts/start.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun run lint:ts && bun run lint:rust && bun run lint:zig && bun run lint:cpp && bun run lint:deny && bun run lint:comments",
    "lint:ts": "oxlint -c oxlint.config.ts",
    "lint:fix": "bun run lint:fix:ts && bun run lint:rust && bun run lint:zig && bun run lint:cpp && bun run lint:deny && bun run lint:comments",
    "lint:fix:ts": "oxlint -c oxlint.config.ts --fix",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint:zig": "zig build --build-file crates/vt/zig/build.zig -Doptimize=Debug --prefix target/zig-check/out --cache-dir target/zig-check/cache",
    "lint:deny": "cargo deny check advisories licenses",
    "lint:comments": "bun scripts/comments.ts",
    "lint:cpp": "bun scripts/cpp.ts lint",
    "format": "oxfmt -c oxfmt.config.ts --check && cargo fmt --all --check && bun run format:zig --check && bun scripts/cpp.ts check",
    "format:fix": "oxfmt -c oxfmt.config.ts --write && cargo fmt --all && bun run format:zig && bun scripts/cpp.ts format",
    "format:zig": "zig fmt crates/vt/zig/build.zig crates/vt/zig/build.zig.zon crates/vt/zig/src",
    "test": "bun run test:ts && bun run test:rust",
    "test:ts": "vitest run",
    "test:rust": "bun scripts/test-rust.ts",
    "test:watch": "vitest",
    "fonts:bundle": "bun scripts/fonts-bundle.ts",
    "brand:icons": "bun scripts/brand-icons.ts",
    "engine:licences": "bun scripts/engine-licences.ts",
    "engine:downloads": "bun scripts/engine-downloads.ts",
    "ffmpeg:pin": "bun scripts/ffmpeg-pin.ts",
    "qt:install": "bun scripts/qt-install.ts",
    "zig:install": "bun scripts/zig-install.ts",
    "qt:static": "bun scripts/qt-static.ts",
    "qt:notices": "bun scripts/qt-notices.ts",
    "ffmpeg:stage": "bun scripts/ffmpeg-stage.ts",
    "ffprobe:stage": "bun scripts/ffprobe-stage.ts",
    "notice:links": "bun scripts/notice-links.ts",
    "examples": "cargo run -q -p opsis-project --bin write-examples",
    "playwright:scripts": "bun scripts/playwright-scripts.ts",
    "types:export": "cargo run -q -p opsis-compile --bin export-spec",
    "elements:render": "cargo run -q --release -p opsis-render --bin render-elements --",
    "glyphs:bundle": "bun scripts/node-glyphs.ts",
    "cursors:bundle": "bun scripts/mac-cursors.ts",
    "paper:noise": "bun scripts/paper-noise.ts",
    "room:environment": "bun scripts/room-environment.ts",
    "script:themes": "bun scripts/script-themes.ts",
    "terminal:themes": "bun scripts/terminal-themes.ts",
    "db:prepare": "bun scripts/sqlx-prepare.ts",
    "skia:build": "bun scripts/skia-build.ts",
    "filament:pin": "bun scripts/filament-pin.ts",
    "filament:build": "bun scripts/filament-build.ts",
    "e2e:qt": "bun scripts/e2e-qt.ts",
    "stage": "bun scripts/stage.ts",
    "make": "bun scripts/make.ts",
    "package:check": "bun scripts/package-check.ts",
    "packager:test": "bun scripts/packager-test.ts",
    "profile": "bun scripts/profile.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/dejavu-sans": "^5.3.0",
    "@fontsource/noto-color-emoji": "^5.3.2",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@lucide/lab": "^0.12.0",
    "@mynaui/icons": "^0.4.11",
    "@oxlint/plugins": "^1.93.0",
    "@paper-design/shaders": "^0.0.82",
    "@tabler/icons": "^3.51.0",
    "@types/node": "^26.6.6",
    "@zip.js/zip.js": "^2.24.0",
    "fast-check": "^4.10.2",
    "iconoir": "^7.12.2",
    "knip": "^6.44.2",
    "lucide": "^1.71.0",
    "morphicons": "^2.0.2",
    "oxc-parser": "^0.158.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.0",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
