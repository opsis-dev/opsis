{
  "name": "opsis",
  "productName": "Opsis",
  "version": "0.1.0",
  "private": true,
  "description": "Record a real website and turn it into a polished product demo.",
  "keywords": [],
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/bismitpanda/opsis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bismitpanda/opsis.git"
  },
  "bugs": {
    "url": "https://github.com/bismitpanda/opsis/issues"
  },
  "author": {
    "name": "Bismit Panda",
    "email": "adnaptimsib333@gmail.com"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "cd crates/desktop && tauri dev",
    "typecheck": "turbo run typecheck typecheck:app",
    "typecheck:app": "tsc --noEmit",
    "lint": "turbo run lint lint:app lint:rust",
    "lint:app": "oxlint -c oxlint.config.ts",
    "lint:fix": "turbo run lint:fix lint:fix:app lint:rust",
    "lint:fix:app": "oxlint -c oxlint.config.ts --fix",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format": "oxfmt -c oxfmt.config.ts --check && cargo fmt --all --check",
    "format:fix": "oxfmt -c oxfmt.config.ts --write && cargo fmt --all",
    "test": "turbo run test test:app test:rust",
    "test:app": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:watch": "turbo watch test test:app",
    "routes": "bun run --cwd apps/ui routes",
    "registry:ingest": "bun scripts/registry-ingest.ts",
    "fonts:bundle": "bun scripts/fonts-bundle.ts",
    "brand:icons": "bun scripts/brand-icons.ts",
    "app:icons": "bun scripts/app-icons.ts",
    "engine:licences": "bun scripts/engine-licences.ts",
    "engine:downloads": "bun scripts/engine-downloads.ts",
    "compositor:sources": "bun scripts/compositor-sources.ts",
    "examples": "cargo run -q -p opsis-project --bin write-examples",
    "playwright:scripts": "bun scripts/playwright-scripts.ts",
    "types:export": "cargo run -q -p opsis-desktop --features export-bindings --bin export-bindings && cargo run -q -p opsis-render --bin export-protocol && cargo run -q -p opsis-compile --bin export-spec",
    "elements:render": "cargo run -q --release -p opsis-render --bin render-elements --",
    "glyphs:bundle": "bun scripts/node-glyphs.ts",
    "db:prepare": "bun scripts/sqlx-prepare.ts",
    "video:bundle": "bun scripts/video-bundle.ts",
    "e2e:app": "cd crates/desktop && CARGO_TARGET_DIR=../../target/e2e tauri build --debug --no-bundle --features e2e",
    "test:e2e": "bun run e2e:app && bun run --cwd e2e e2e",
    "stage": "bun scripts/stage.ts",
    "make": "bun scripts/make.ts"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@opsis/sidecar": "workspace:*",
    "@opsis/ui": "workspace:*",
    "@opsis/video": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.89.0",
    "@remotion/bundler": "4.0.537",
    "@remotion/tailwind-v4": "4.0.537",
    "@tabler/icons": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.44",
    "@tanstack/router-plugin": "^1.168.46",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "diff": "^9.0.0",
    "happy-dom": "^21.0.4",
    "lucide": "^1.61.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  }
}
