{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": ".turbo/cache",
  "globalDependencies": [
    "tsconfig.base.json",
    "scripts/lib/oxlint-base.ts",
    "scripts/lib/tool-config.ts",
    "scripts/lib/vitest-base.ts",
    "scripts/oxlint-plugin-opsis.ts"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "//#typecheck:app": {
      "cache": false
    },
    "//#lint:app": {
      "cache": false
    },
    "//#lint:fix:app": {
      "cache": false
    },
    "//#test:app": {
      "cache": false
    },
    "//#lint:rust": {
      "cache": false
    },
    "//#lint:deny": {
      "cache": false
    },
    "//#lint:comments": {
      "cache": false
    },
    "//#test:rust": {
      "cache": false
    }
  }
}
